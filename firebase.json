{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "clmschedule",
          "appId": "1:346281153032:android:19e5702f1e0afae2d577bd",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
