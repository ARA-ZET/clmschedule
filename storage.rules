rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // "Staff" = a real account. Anonymous sign-ins are EXCLUDED, same as
    // signedIn() in firestore.rules: anonymous auth is enabled on this project
    // and the public API key ships in every client, so `request.auth != null`
    // alone lets anyone on the internet upload, overwrite and delete. The
    // clmgpx field app (the only anonymous client) uploads tracks to Drive;
    // its one Storage grant is creating vehicle inspection photos below.
    function staff() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function fieldApp() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Images shown in the apps. Download URLs carry their own token and work
    // regardless of the read rules, so tightening reads breaks no <img>.
    function imageUpload() {
      return request.resource == null // delete
          || (request.resource.size < 10 * 1024 * 1024
              && request.resource.contentType.matches('image/.*'));
    }

    match /inventory_tools/{imageName} {
      allow read: if true; // Anyone can read (for displaying images)
      allow write: if staff() && imageUpload();
    }

    // Happy Sun project images AND videos, so no type or size cap here.
    match /happySunProjects/{allPaths=**} {
      allow read: if true; // Anyone can read (for displaying images/videos)
      allow write: if staff();
    }

    // Map thumbnails; anyone can view them
    match /mapThumbnails/{imageName} {
      allow read: if true;
      allow write: if staff() && imageUpload();
    }

    // Cloud Files: GPX tracks plus any file type, of any size (archives,
    // folders dragged in). Reads stay public because the unauthenticated map
    // share-link viewer lists and downloads a map's cloud tracks directly.
    match /Distribution/{allPaths=**} {
      allow read: if true;
      allow write: if staff();
    }

    // Suburb KML data: anyone can download; only staff can upload
    match /suburbs/{fileName} {
      allow read: if true;
      allow write: if staff();
    }

    // Distributor profile photos: personal data, so staff-only reads.
    match /distributor_photos/{fileName} {
      allow read: if staff();
      allow write: if staff() && imageUpload();
    }

    // Company details (e.g. logo)
    match /company/{fileName} {
      allow read: if true;
      allow write: if staff() && imageUpload();
    }

    // Packed ERF cadastral data: one gzipped file per downloaded area,
    // holding every parcel boundary. Staff required to read as well as
    // write — unlike the public assets above, this is bulk survey data
    // rather than something a page needs to display anonymously.
    match /erfAreas/{fileName} {
      allow read, write: if staff();
    }

    // Curated letterbox positions: one gzipped file per suburb. Staff
    // required to read as well as write — this is the dataset the business
    // quotes from and reviews distributors against, not a public asset.
    match /letterboxes/{fileName} {
      allow read, write: if staff();
    }

    // Recycle Bin: deleted Cloud Files and oversized payloads of deleted
    // items, kept 30 days for restore. Staff only; never public.
    match /recycleBin/{allPaths=**} {
      allow read, write: if staff();
    }

    // Vehicle inspection photos from clmgpx:
    // {date}/{date}_{vehicleKey}_{start|end}/{slot}_{token}.jpg. The field
    // app may only CREATE — never read, overwrite or delete — a JPEG under
    // 1.5 MB (phones compress to ~300 KB). Each upload attempt uses a new
    // token, so a retry never needs to overwrite. Anonymous tokens are free
    // to mint, so the cost of this grant is junk uploads of at most 1.5 MB;
    // a 90-day bucket lifecycle rule on this prefix deletes old photos.
    match /vehicleInspections/{date}/{inspectionId}/{fileName} {
      allow read, delete: if staff();
      allow create: if (staff() || fieldApp())
          && resource == null
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && inspectionId.matches('^' + date + '_[A-Za-z0-9-]{1,32}_(start|end)$')
          && fileName.matches('^[a-z_]{1,20}_[A-Za-z0-9]{6,32}[.]jpg$')
          && request.resource.size < 1536 * 1024
          && request.resource.contentType == 'image/jpeg';
    }

    // Driver issue photos from clmgpx:
    // {date}/{date}_{token}/photo{1-3}_{token}.jpg. Create-only for the
    // field app, same limits as inspection photos.
    match /driverIssues/{date}/{issueId}/{fileName} {
      allow read, delete: if staff();
      allow create: if (staff() || fieldApp())
          && resource == null
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && issueId.matches('^' + date + '_[a-z0-9]{12}$')
          && fileName.matches('^photo[1-3]_[a-z0-9]{12}[.]jpg$')
          && request.resource.size < 1536 * 1024
          && request.resource.contentType == 'image/jpeg';
    }

    // Deny access to all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
