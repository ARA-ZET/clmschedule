rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read and write inventory tool images
    match /inventory_tools/{imageName} {
      allow read: if true; // Anyone can read (for displaying images)
      allow write: if request.auth != null; // Only authenticated users can upload
    }
    
    // Allow authenticated users to read and write Happy Sun project images/videos
    match /happySunProjects/{allPaths=**} {
      allow read: if true; // Anyone can read (for displaying images/videos)
      allow write: if request.auth != null; // Only authenticated users can upload
    }
    
    // Allow authenticated users to upload map thumbnails; anyone can view them
    match /mapThumbnails/{imageName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Deny access to all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
