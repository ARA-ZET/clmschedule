rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read and write inventory tool images
    match /inventory_tools/{imageName} {
      allow read: if true; // Anyone can read (for displaying images)
      allow write: if request.auth != null; // Only authenticated users can upload
    }
    
    // Allow authenticated users to read and write Happy Sun project images/videos
    match /happySunProjects/{allPaths=**} {
      allow read: if true; // Anyone can read (for displaying images/videos)
      allow write: if request.auth != null; // Only authenticated users can upload
    }
    
    // Allow authenticated users to upload map thumbnails; anyone can view them
    match /mapThumbnails/{imageName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow authenticated users to upload/manage distribution GPX files; anyone can read
    match /Distribution/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Suburb KML data: anyone can download; only authenticated users can upload
    match /suburbs/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to upload/read distributor profile photos
    match /distributor_photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to upload/read company details (e.g. logo)
    match /company/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Packed ERF cadastral data: one gzipped file per downloaded area,
    // holding every parcel boundary. Sign-in required to read as well as
    // write — unlike the public assets above, this is bulk survey data
    // rather than something a page needs to display anonymously.
    match /erfAreas/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Curated letterbox positions: one gzipped file per suburb. Sign-in
    // required to read as well as write — this is the dataset the business
    // quotes from and reviews distributors against, not a public asset.
    match /letterboxes/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Deny access to all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
